rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// SERENITY — REGLAS DE FIRESTORE
//
// Principio: cada quien solo ve y toca LO SUYO.
//
// Las Cloud Functions usan el SDK de administrador y NO pasan por estas
// reglas. Por eso `videos_catalogo`, `videos_youtubers`, `canales_youtubers`,
// `canales_admin`, `estado_fetch`, `fetch_logs` y `compras_play` pueden quedar
// cerradas a la app: las llena el servidor.
//
// ───────────────────────────────────────────────────────────────────────────
// QUÉ CAMBIÓ RESPECTO A LAS REGLAS ORIGINALES
//
// 1. `ninos` tenía `allow read: if true`. Cualquiera en internet, sin
//    cuenta, podía descargarse nombre, fecha de nacimiento, password_hash,
//    código de vinculación y COORDENADAS GPS de todos los niños.
//
// 2. `padres` tenía `allow read, write: if request.auth != null`, o sea que
//    cualquier usuario registrado leía y escribía el documento de cualquier
//    otro. De ahí salía el hueco del premium: bastaba escribir
//    `premium: true` en tu propio documento.
//
// 3. `ninos` permitía `delete` a cualquier usuario registrado.
//
// 4. `tiempo_uso` dejaba leer el historial de uso de CUALQUIER niño.
//
// ───────────────────────────────────────────────────────────────────────────
// QUÉ CAMBIÓ EN ESTA REVISIÓN
//
// 5. `ninos` separó `get` de `list`. Antes, la cláusula que permite leer un
//    niño sin dueño (necesaria para vincular) también permitía CONSULTAR la
//    colección filtrando por `id_padre == null`. Es decir: cualquier usuario
//    con cuenta podía listar todos los perfiles aún sin vincular y leerles
//    nombre, fecha de nacimiento, contraseña y código. Con el código se
//    vincula el hijo de otra familia a la cuenta propia.
//
// 6. `ninos` perdió la vía de vinculación desde el cliente en `update`. Hoy
//    vincula la Cloud Function `vincularNino`, que además verifica el tope
//    de hijos del plan. La regla vieja dejaba que cualquiera se adjudicara
//    un niño sin dueño escribiendo su propio uid.
//
// 7. `sesiones` se cerró. Exigía un cambio de código, y ese cambio ya está:
//    el documento se guarda con `device_id` como id, así que `guardarSesion`
//    ya no consulta la colección y nadie necesita poder listarla.
//
// ⚠️ EL PUNTO 7 SOLO FUNCIONA CON EL CÓDIGO NUEVO DE `guardarSesion`.
//    Si despliegas estas reglas con la versión vieja, guardar la sesión
//    falla y el padre deja de recibir notificaciones push.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── AYUDAS ───────────────────────────────────────────────────────────
    //
    // ⚠️ Las cuatro van al MISMO nivel, una detrás de otra. En las reglas de
    // Firestore no se pueden anidar funciones: si a una se le escapa una
    // llave y la siguiente queda dentro, el error que sale es
    // "Invalid function name", que no dice nada sobre la llave.

    function conCuenta() {
      return request.auth != null;
    }

    function miUid() {
      return request.auth.uid;
    }

    // Campos del plan. Los escribe SOLO una Cloud Function. Si el cliente
    // pudiera tocarlos, un APK modificado se pondría Premium solo y todas las
    // compuertas de la app serían adorno.
    //
    // Los tres últimos los agregó Play Billing. Ninguno decide por sí solo si
    // hay Premium —eso lo deciden `premium` y `premium_hasta`— pero se
    // protegen igual: son el rastro de qué compra dio el acceso, la única
    // pista que queda para investigar un cobro en disputa.
    function camposDelPlan() {
      return ['premium', 'premium_hasta', 'premium_origen',
              'premium_estado_play', 'premium_product_id',
              'premium_actualizado_en',
              // No es un campo del plan, pero se protege igual y por el
              // mismo motivo: lo escribe SOLO el servidor.
              //
              // `es_dispositivo_nino` marca las cuentas que son el teléfono
              // de un menor. Lo pone `vincularNino` cuando detecta que el
              // perfil lo creó una cuenta distinta a la que lo vincula, y de
              // ahí cuelga el trato especial que esa cuenta debe recibir.
              // Si el cliente pudiera quitársela, la marca no valdría nada.
              'es_dispositivo_nino'];
    }

    function noTocaElPlan() {
      return !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(camposDelPlan());
    }

    // ── PADRES ───────────────────────────────────────────────────────────
    match /padres/{padreId} {
      // Solo tu propio documento. Antes cualquiera leía el de todos:
      // correo, nombre completo, fecha de nacimiento y ubicación.
      allow read: if conCuenta() && padreId == miUid();

      allow create: if conCuenta()
                    && padreId == miUid()
                    && !request.resource.data.keys().hasAny(camposDelPlan());

      allow update: if conCuenta()
                    && padreId == miUid()
                    && noTocaElPlan();

      // La cuenta se marca `eliminado: true`, no se borra el documento.
      allow delete: if false;
    }

    // ── NIÑOS ────────────────────────────────────────────────────────────
    //
    // Aquí `read` se parte en sus dos operaciones reales, y esa separación
    // es TODO el arreglo:
    //
    //   · `get`  = traer UN documento del que ya conoces el id.
    //   · `list` = consultar la colección y recibir varios.
    //
    // El agujero nunca estuvo en `get`: estaba en `list`. La pantalla de
    // registro del niño crea el perfil y se queda escuchando ESE documento
    // —`streamNino(ninoId)`, un `get`— hasta que el padre lo vincula. Para
    // eso necesita poder leer un niño con `id_padre == null`.
    //
    // Pero esa misma cláusula, en un `list`, dejaba consultar
    // `where('id_padre', isEqualTo: null)` y bajarse TODOS los perfiles sin
    // vincular del sistema, con contraseña y código incluidos.
    //
    // Separándolas, para leer un niño sin dueño hay que conocer de antemano
    // su id de documento —20 caracteres aleatorios que genera Firestore— y
    // ya no se puede enumerar la colección.
    // ═══════════════════════════════════════════════════════════════════
    // DOS DUEÑOS, NO UNO
    //
    // Antes un perfil de niño tenía un solo dueño: `id_padre`. Eso daba por
    // supuesto que el teléfono del niño estaba autenticado con la cuenta del
    // padre, porque era la única forma de que `id_padre == miUid()` fuera
    // cierto allí.
    //
    // Cuando eso no se cumplía, el fallo era desconcertante: el perfil se
    // creaba bien y el listener de vinculación arrancaba bien —mientras
    // `id_padre` es null cualquiera con cuenta puede leerlo— y moría con
    // PERMISSION_DENIED en el instante EXACTO en que el padre metía el
    // código, porque justo ahí `id_padre` dejaba de ser null y pasaba a ser
    // un uid ajeno. La app decía "Conexión perdida".
    //
    // Ahora el documento guarda también `uid_nino`: el uid de la sesión que
    // creó el perfil, o sea la del dispositivo del niño. Un perfil pertenece
    // a los dos, con permisos MUY distintos:
    //
    //   id_padre  → manda. Configura categorías, contraseña, límites.
    //   uid_nino  → solo reporta. Su ubicación y su tiempo de uso.
    //
    // ⚠️ `uid_nino` se fija al crear y NO se puede cambiar nunca más. Si se
    //    pudiera reescribir, cualquiera se adjudicaría el perfil de otro
    //    niño y le leería la ubicación.
    //
    // Compatibilidad: los perfiles creados antes de esto no tienen el campo.
    // Por eso se lee con `.get('uid_nino', null)` y no con acceso directo:
    // en las reglas de Firestore, leer un campo que no existe no da false,
    // da ERROR DE EVALUACIÓN, y el error se traduce en denegar. Sin el
    // `.get()`, esta regla le habría cerrado la app a todos los usuarios
    // anteriores al cambio.
    // ═══════════════════════════════════════════════════════════════════
    match /ninos/{ninoId} {

      function esElPadre() {
        return resource.data.get('id_padre', null) == miUid();
      }

      function esElDispositivoDelNino() {
        return resource.data.get('uid_nino', null) == miUid();
      }

      // Lo que el dispositivo del niño tiene permitido escribir: lo que
      // reporta sobre sí mismo, y nada más. No puede tocar las categorías
      // permitidas, ni la contraseña, ni el límite de tiempo, ni mucho menos
      // `id_padre` o `uid_nino`.
      //
      // Esto además APRIETA lo que había antes: cuando el teléfono del niño
      // usaba la sesión del padre, tenía permiso para reescribir el perfil
      // entero, incluidas las categorías que su papá le había restringido.
      function soloCamposDelNino() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'latitud',
                   'longitud',
                   'precision_metros',
                   'fecha_ultima_ubicacion',
                   'consumido_segundos',
                   'sesion_activa',
                   'limite_fecha',
                   'ultimo_latido',
                   'aviso_5min_enviado',
                   'aviso_fin_enviado',
                   // La foto de perfil la elige el NIÑO, así que tiene que
                   // poder escribirla él. Es el único campo de esta lista
                   // que no es telemetría.
                   //
                   // No abre nada: guarda un id corto de un catálogo cerrado
                   // que vive dentro de la app, no una imagen ni una URL. Lo
                   // peor que puede escribir un APK modificado es un id que
                   // no existe, y entonces se ve la inicial de siempre.
                   'avatar'
                 ]);
      }

      // Un documento suelto: el tuyo, el del niño de este teléfono, o el que
      // todavía espera vinculación.
      allow get: if conCuenta() && (
                   esElPadre() ||
                   esElDispositivoDelNino() ||
                   resource.data.get('id_padre', null) == null
                 );

      // Consultas. El `||` no abre nada: las reglas se evalúan contra CADA
      // documento devuelto, así que una consulta solo puede traer perfiles
      // en los que quien pregunta es el padre o es el dispositivo del niño.
      // Cualquier otro documento que cayera en el resultado tumbaría la
      // consulta entera.
      allow list: if conCuenta() && (
                    esElPadre() ||
                    esElDispositivoDelNino()
                  );

      // Un perfil nace sin dueño, desactivado, y marcado con el uid del
      // dispositivo que lo está creando.
      //
      // ⏳ LA SEGUNDA RAMA ES TEMPORAL, Y SIN ELLA SE ROMPE LA APP VIEJA.
      //
      // Las reglas se despliegan de golpe; los APK se actualizan cuando cada
      // usuario quiere. Un teléfono con la versión anterior llama a
      // `crearNino()` sin `uid_nino`, así que exigirlo a secas le impediría
      // registrar un niño — a todo el que no haya actualizado todavía, y sin
      // ningún aviso que le diga por qué.
      //
      // No abre nada: un perfil creado sin `uid_nino` se comporta como antes
      // —solo lo alcanza el padre que lo vincule— porque `esElDispositivoDelNino()`
      // nunca será cierto para él.
      //
      // CUÁNDO QUITARLA: cuando la versión mínima en Play Console ya incluya
      // este cambio, o cuando `auditoria-datos.js` reporte cero perfiles sin
      // `uid_nino` creados después de la fecha de publicación.
      // ⚠️ TODO CON `.get()`, NUNCA CON ACCESO DIRECTO.
      //
      // `request.resource.data.id_padre` sobre una escritura que no trae ese
      // campo no devuelve false: LANZA un error de evaluación. El resultado
      // final es el mismo —denegar— pero el error tapa el motivo real y hace
      // imposible leer por qué falló algo en los registros.
      allow create: if conCuenta()
                    && request.resource.data.get('id_padre', null) == null
                    && request.resource.data.get('activo', true) == false
                    && (
                      request.resource.data.get('uid_nino', null) == miUid() ||
                      request.resource.data.get('uid_nino', null) == null
                    );

      // Solo el dueño.
      //
      // ❌ SE ELIMINÓ LA VINCULACIÓN DESDE EL CLIENTE. La regla anterior
      // permitía que cualquier usuario con cuenta se adjudicara un niño sin
      // dueño con solo escribir su propio uid. Hoy vincula la Cloud Function
      // `vincularNino`, que entra con el SDK de administrador —no pasa por
      // estas reglas— y de paso verifica el tope de hijos del plan, cosa que
      // el cliente no podía hacer de forma confiable.
      // ── EL PADRE: manda sobre el perfil ──────────────────────────────
      //
      // Lo único que tampoco puede es reescribir a quién pertenece ni si el
      // perfil entra en el plan. Sin esas condiciones, un padre podría
      // apuntar `uid_nino` a otro dispositivo, cederse un perfil ajeno, o
      // —lo más goloso— ponerse `dentro_del_plan: true` en todos sus hijos
      // desde un APK modificado y saltarse el Premium entero.
      //
      // `dentro_del_plan` lo escribe SOLO el servidor, en
      // `recalcularAccesoHijos()`, que corre con el SDK de administrador y
      // no pasa por estas reglas.
      //
      // El `resource != null` de delante no sobra: una escritura con
      // `set(merge: true)` hace que el motor evalúe TAMBIÉN la rama de
      // update, y ahí `resource` puede venir nulo. Sin la guarda, esta regla
      // lanza en vez de responder.
      allow update: if conCuenta()
                    && resource != null
                    && esElPadre()
                    && request.resource.data.get('id_padre', null) == resource.data.get('id_padre', null)
                    && request.resource.data.get('uid_nino', null) == resource.data.get('uid_nino', null)
                    && request.resource.data.get('dentro_del_plan', null) == resource.data.get('dentro_del_plan', null);

      // ── EL DISPOSITIVO DEL NIÑO: solo reporta lo suyo ────────────────
      allow update: if conCuenta()
                    && resource != null
                    && esElDispositivoDelNino()
                    && soloCamposDelNino();

      // Nunca se borra: se marca `eliminado: true`. Así no quedan colgando
      // las referencias del historial de uso ni de las sesiones.
      allow delete: if false;
    }

    // ── CANALES QUE AGREGA EL PADRE ──────────────────────────────────────
    //
    // ⚠️ LOS ESCRIBE EL PADRE PERO LOS LEE EL NIÑO.
    //
    // Es el mismo reparto que en `uso_diario`, y se olvidó al separar las
    // cuentas. La regla exigía `id_padre == miUid()` también para leer, así
    // que el teléfono del niño —con su propia cuenta— se topaba con un
    // PERMISSION_DENIED al cargar sus videos.
    //
    // Y no fallaba a medias: en Firestore una consulta denegada **falla
    // entera**, así que no era "faltan los canales que agregó papá", era que
    // no cargaba ningún video. Un fallo en una colección secundaria tumbaba
    // la pantalla principal del niño.
    //
    // Por eso el documento guarda ahora también `uid_nino`, copiado del
    // perfil al agregar el canal. Escribir y borrar siguen siendo solo del
    // padre: el niño no se agrega canales a sí mismo.
    match /canales/{canalId} {
      allow read: if conCuenta() && (
                    resource.data.get('id_padre', null) == miUid() ||
                    resource.data.get('uid_nino', null) == miUid()
                  );

      allow create: if conCuenta()
                    && request.resource.data.get('id_padre', null) == miUid();

      allow update, delete: if conCuenta()
                            && resource != null
                            && resource.data.get('id_padre', null) == miUid();
    }

    // ── CATÁLOGO ─────────────────────────────────────────────────────────
    // Lo llenan las Cloud Functions. La app solo lee, y con cuenta: este
    // catálogo curado es el producto, no hay razón para regalarlo a quien
    // no ha entrado.
    match /canales_youtubers/{docId} {
      allow read: if conCuenta();
      allow write: if false;
    }

    match /videos_catalogo/{docId} {
      allow read: if conCuenta();
      allow write: if false;
    }

    match /videos_youtubers/{docId} {
      allow read: if conCuenta();
      allow write: if false;
    }

    // ── SESIONES ─────────────────────────────────────────────────────────
    //
    // Guarda el token de notificaciones de cada dispositivo. Antes estaba
    // abierta a cualquier usuario con cuenta, o sea que un usuario
    // registrado podía listar la colección y bajarse los `device_token` de
    // todos los demás.
    //
    // Estaba así porque `guardarSesion()` buscaba con
    // `where('device_id', ...)`, y una consulta que Firestore no puede
    // demostrar segura obliga a abrir el `list` entero.
    //
    // El código nuevo no consulta: guarda en
    // `sesiones/{device_id}_{tipo_usuario}`, un id que el propio dispositivo
    // ya conoce. Sin consulta, no hace falta `list`.
    //
    //   · LECTURA CERRADA DEL TODO. La app nunca lee esta colección:
    //     `validarSesion()` no se llamaba desde ninguna parte. Quien sí lee
    //     es `notificarAlPadre()` en las Cloud Functions, con el SDK de
    //     administrador, que no pasa por aquí.
    //   · ESCRITURA SOLO DE LO PROPIO: `id_usuario` tiene que ser tu uid.
    //     Así nadie apunta la sesión de otro a su cuenta ni le borra el
    //     token para dejarlo sin notificaciones.
    match /sesiones/{sesionId} {
      allow read: if false;

      allow create, update: if conCuenta()
                            && request.resource.data.id_usuario == miUid();

      allow delete: if false;
    }

    // ── TIEMPO DE USO (colección antigua) ────────────────────────────────
    //
    // ⚠️ Tenía `allow read: if conCuenta()`, o sea que cualquier usuario
    // registrado podía leer el historial de uso de CUALQUIER niño. Se cerró.
    //
    // Nada en la app la lee: los documentos no llevan `id_padre`, así que no
    // hay forma de escribir una regla que distinga al dueño. El reporte
    // semanal usa `uso_diario`, que sí lo lleva. Esta colección se conserva
    // solo para no perder lo ya escrito.
    match /tiempo_uso/{registroId} {
      allow read: if false;
      allow create: if conCuenta();
      allow update, delete: if false;
    }

    // ── USO DIARIO (alimenta el reporte semanal) ─────────────────────────
    //
    // Un documento por niño y por mes: `uso_diario/{ninoId}_{yyyy-MM}`, con
    // un mapa `dias` de "yyyy-MM-dd" a segundos.
    //
    // `id_padre` va guardado dentro del documento a propósito. Sin él, la
    // regla tendría que hacer un get() al documento del niño para saber de
    // quién es, y eso cuesta una lectura extra por cada documento leído.
    //
    // ⚠️ AQUÍ ESCRIBE EL NIÑO Y LEE EL PADRE — Y YA NO SON EL MISMO UID.
    //
    // Antes lo eran: al modo niño se entraba después de que el padre iniciara
    // sesión, así que `miUid()` servía para las dos cosas. Con cuentas
    // separadas el dispositivo del niño tiene su propio uid, y una regla que
    // solo mirara `id_padre` le cerraría la escritura de su propio uso.
    //
    // Por eso el documento guarda los DOS uids. Es la misma decisión que ya
    // estaba tomada para `id_padre`: duplicar el dato dentro del documento
    // sale más barato que hacer un get() al perfil del niño en cada lectura.
    //
    // El reparto es asimétrico a propósito:
    //
    //   id_padre  → lee (reporte semanal) y borra (eliminación de cuenta)
    //   uid_nino  → solo escribe su propio uso. NO lee el historial: un
    //               teléfono infantil no tiene por qué poder descargar el
    //               registro de meses anteriores.
    match /uso_diario/{docId} {
      // `resource == null` cubre el mes que todavía no existe: sin eso, leer
      // un mes sin uso devolvería PERMISSION_DENIED en vez de "no está".
      allow read: if conCuenta() && (
                    resource == null ||
                    resource.data.get('id_padre', null) == miUid()
                  );

      allow create: if conCuenta() && (
                      request.resource.data.get('id_padre', null) == miUid() ||
                      request.resource.data.get('uid_nino', null) == miUid()
                    );

      // No se puede cambiar de dueño en una actualización: los dos uids
      // tienen que seguir siendo los mismos después de escribir.
      //
      // ⚠️ CON UNA EXCEPCIÓN, Y ES NECESARIA. Los documentos de uso escritos
      // antes de este cambio no tienen `uid_nino`. Cuando el teléfono del
      // niño vuelva a reportar sobre el mes en curso, va a escribirlo por
      // primera vez: eso es null → miUid(), que sin esta excepción sería
      // "cambiar de dueño" y quedaría denegado. El niño no podría seguir
      // registrando su tiempo en el mes que ya tenía empezado.
      //
      // Solo se permite estrenar el campo con el uid PROPIO, y solo a quien
      // YA es dueño del documento por la otra vía. Apuntarlo a un tercero
      // sigue prohibido, y una vez puesto ya no se puede mover.
      //
      // Lo que NO se hace aquí: permitir la escritura solo porque el campo
      // esté vacío. Sería un hueco — cualquiera con cuenta podría adivinar
      // un id `{ninoId}_{yyyy-MM}` y escribir en el historial de otro niño.
      allow update: if conCuenta()
                    && resource != null
                    && (
                      resource.data.get('id_padre', null) == miUid() ||
                      resource.data.get('uid_nino', null) == miUid()
                    )
                    && request.resource.data.get('id_padre', null) == resource.data.get('id_padre', null)
                    && (
                      request.resource.data.get('uid_nino', null) == resource.data.get('uid_nino', null) ||
                      (
                        resource.data.get('uid_nino', null) == null &&
                        request.resource.data.get('uid_nino', null) == miUid()
                      )
                    );

      // Solo se borra al eliminar el perfil del niño o la cuenta entera, y
      // solo lo tuyo.
      //
      // Antes estaba en `false`, con el criterio de que un historial no se
      // borra. El criterio cambió por una razón concreta: los requisitos de
      // eliminación de cuentas de Google Play exigen que los datos se
      // supriman de verdad cuando el usuario lo pide, y la página pública de
      // eliminación promete que este historial desaparece. Una regla que lo
      // impidiera convertiría esa promesa en mentira.
      //
      // No abre nada: hay que ser el PADRE. El dispositivo del niño puede
      // escribir su uso pero no borrarlo — si no, bastaría con abrir la app
      // del niño para hacer desaparecer las horas de ayer.
      allow delete: if conCuenta()
                    && resource != null
                    && resource.data.get('id_padre', null) == miUid();
    }

    // ── COMPRAS DE GOOGLE PLAY ───────────────────────────────────────────
    //
    // Un documento por `purchaseToken`, con el uid del padre que lo reclamó.
    // Es lo que impide que una persona compre, saque su token del teléfono y
    // se lo pase a diez amigos: la segunda cuenta que lo presente se rechaza.
    //
    // Cerrada por los dos lados a propósito:
    //
    //   · La app no lo necesita LEER. El estado del plan lo lee de
    //     `padres/{id}`; esto es contabilidad interna del servidor.
    //   · Si la app pudiera ESCRIBIR, el candado no serviría de nada:
    //     bastaría con borrar el registro del dueño anterior para volver a
    //     reclamar el mismo token.
    //
    // `verificarCompra` y `notificacionesPlay` entran con el SDK de
    // administrador y no pasan por aquí, así que funcionan igual.
    match /compras_play/{purchaseToken} {
      allow read, write: if false;
    }

    // ── SOLO SERVIDOR ────────────────────────────────────────────────────
    // fetch_logs, estado_fetch, canales_admin y categoria_contenido no los
    // toca la app. Las Cloud Functions entran por el SDK de administrador,
    // que no pasa por estas reglas.
    match /fetch_logs/{docId} {
      allow read, write: if false;
    }

    // ── TODO LO DEMÁS: DENEGADO ──────────────────────────────────────────
    // Red de seguridad. Si mañana alguien crea una colección nueva y olvida
    // ponerle reglas, queda cerrada en vez de abierta. Esta regla no anula
    // los permisos de arriba: en Firestore los `allow` se suman.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
