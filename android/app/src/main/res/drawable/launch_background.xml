<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo de la pantalla que Android muestra mientras arranca el motor de
  Flutter, en teléfonos anteriores a Android 12.

  Era @android:color/white. Con eso el arranque era: blanco → azul oscuro de
  Serenity, un salto de color que se lee como "dos pantallas de carga".

  Ahora usa el MISMO azul que la pantalla de bienvenida de Flutter
  (AppColors.bgPrimary = #0F172A), así el arranque se ve como una sola
  pantalla continua.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
</layer-list>
